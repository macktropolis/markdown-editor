{
  "name": "astro-content-editor",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "npm run build && node server/index.js",
    "serve": "node server/index.js",
    "typecheck": "tsc --noEmit",
    "prepare": "vite build"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@uiw/react-codemirror": "^4.25.4",
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "description": "A dev-only MDX content editor mounted into an Astro site",
  "license": "MIT",
  "exports": {
    ".": "./integration/index.js"
  },
  "files": [
