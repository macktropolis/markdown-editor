---
/**
 * Figure — a centred image with an optional caption and credit line.
 *
 * Props:
 *   src      — imported ImageMetadata, not a path string
 *   alt      — alt text; required, because a decorative figure should not be a Figure
 *   caption  — text shown beneath the image
 *   credit   — attribution appended to the caption in smaller type
 *   width    — CSS width for the figure (default '100%')
 *   rounded  — round the image corners
 */

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  credit?: string;
  width?: string;
  rounded?: boolean;
}

const { src, alt, caption, credit, width = '100%', rounded = false } = Astro.props;
---

<figure class="figure" style={`width: ${width}; margin: 1.75rem auto;`}>
  <Image src={src} alt={alt} width={1200} style={rounded ? 'border-radius: 10px;' : ''} />
  {(caption || credit) && (
    <figcaption>
      {caption}
      {credit && <span class="credit"> — {credit}</span>}
    </figcaption>
  )}
</figure>

<style>
  .figure img { display: block; width: 100%; height: auto; }
  figcaption { margin-top: 0.5rem; font-size: 0.8rem; text-align: center; opacity: 0.7; }
  .credit { font-style: italic; }
</style>
